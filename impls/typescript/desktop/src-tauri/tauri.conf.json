{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tcode",
  "version": "0.2.0",
  "identifier": "io.ggbdpq.tcode",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "resources": {
      "../../bin/": "backend/bin/",
      "../../src/": "backend/src/",
      "../../package.json": "backend/package.json"
    },
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/32x32.png", "icons/128x128.png"]
  }
}
